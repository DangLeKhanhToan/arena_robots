      <inertia ixx="1.6666666666666668e-07" ixy="0.0" ixz="0.0" iyy="1.6666666666666668e-07" iyz="0.0" izz="1.6666666666666668e-07"/>
    </inertial>
  </link>
  <joint name="head_camera_right_camera_joint" type="fixed">
    <parent link="head_camera_link"/>
    <child link="head_camera_right_camera_frame"/>
    <origin rpy="0 0 0" xyz="0 -0.0375 0"/>
  </joint>
  <link name="head_camera_right_camera_optical_frame">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.6666666666666668e-07" ixy="0.0" ixz="0.0" iyy="1.6666666666666668e-07" iyz="0.0" izz="1.6666666666666668e-07"/>
    </inertial>
  </link>
  <joint name="head_camera_right_camera_optical_joint" type="fixed">
    <origin rpy="-1.5707963267948966 0.0 -1.5707963267948966" xyz="0 0 0"/>
    <parent link="head_camera_right_camera_frame"/>
    <child link="head_camera_right_camera_optical_frame"/>
  </joint>
  <!-- IMU -->
  <link name="head_camera_imu_frame">
    <inertial>
      <mass value="0.01"/>
      <origin xyz="0 0 0"/>
      <inertia ixx="1.6666666666666668e-07" ixy="0.0" ixz="0.0" iyy="1.6666666666666668e-07" iyz="0.0" izz="1.6666666666666668e-07"/>
    </inertial>
  </link>
  <joint name="head_camera_imu_joint" type="fixed">
    <parent link="head_camera_link"/>
    <child link="head_camera_imu_frame"/>
    <origin rpy="-1.5707963267948966 0 -1.5707963267948966" xyz="0 0 0"/>
  </joint>
  <gazebo reference="head_camera_imu_frame">
    <sensor name="head_camera_imu" type="imu">
      <plugin filename="libgz-sim-imu-system" name="gz::sim::systems::Imu">
        <topic>/imu/data</topic>
        <frame_id>head_camera_imu_frame</frame_id>
      </plugin>
      <always_on>true</always_on>
      <update_rate>100</update_rate>
      <visualize>true</visualize>
      <imu>
        <angular_velocity>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>2e-4</stddev>
              <bias_mean>0.0000075</bias_mean>
              <bias_stddev>0.0000008</bias_stddev>
            </noise>
          </z>
        </angular_velocity>
        <linear_acceleration>
          <x>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </x>
          <y>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </y>
          <z>
            <noise type="gaussian">
              <mean>0.0</mean>
              <stddev>1.7e-2</stddev>
              <bias_mean>0.1</bias_mean>
              <bias_stddev>0.001</bias_stddev>
            </noise>
          </z>
        </linear_acceleration>
      </imu>
    </sensor>
    <material>Gazebo/Grey</material>
  </gazebo>
  <gazebo reference="head_camera_rgb_camera_frame">
    <sensor name="head_camera" type="rgbd_camera">
      <pose>0 0 0 0 0 0</pose>
      <gz_frame_id>/head_camera_rgb_camera_frame</gz_frame_id>
      <update_rate>30</update_rate>
      <camera>
        <horizontal_fov>1.25</horizontal_fov>
        <image>
          <width>320</width>
          <height>240</height>
          <format>R8G8B8</format>
        </image>
        <clip>
          <near>0.3</near>
          <far>100</far>
        </clip>
      </camera>
      <always_on>1</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>
  <gazebo reference="head_camera_rgb_camera_frame">
    <visual>
      <material>
        <diffuse>0.011764705882352941 0.011764705882352941 0.011764705882352941 1</diffuse>
        <specular>0 0 0 1</specular>
        <emissive>0 0 0 1</emissive>
      </material>
    </visual>
  </gazebo>
  <gazebo reference="head_camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="head_camera_rgb_camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="head_camera_rgb_camera_optical_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="head_camera_left_camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="head_camera_left_camera_optical_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="head_camera_right_camera_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="head_camera_right_camera_optical_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <gazebo reference="head_camera_imu_joint">
    <preserveFixedJoint>true</preserveFixedJoint>
  </gazebo>
  <link name="imu_link"/>
  <joint name="imu_link_joint" type="fixed">
    <origin rpy="0.0 0.0 0.0" xyz="0.10171 0.0 0.11282"/>
    <parent link="base_link"/>
    <child link="imu_link"/>
  </joint>
  <gazebo reference="imu_link">
    <sensor name="imu_sensor" type="imu">
      <update_rate>100</update_rate>
      <always_on>true</always_on>
      <gz_frame_id>/imu_link</gz_frame_id>
    </sensor>
  </gazebo>
</robot>
