  <link name="head_camera_color_optical_frame"/>
  <gazebo reference="head_camera_color_frame">
    <sensor name="head_camera_color" type="camera">
      <camera name="head_camera_color">
        <horizontal_fov>1.2112585008840648</horizontal_fov>
        <vertical_fov>0.6806784082777885</vertical_fov>
        <image>
          <width>1920</width>
