<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="tiago_arm_fragment">
  <group name="arm">
    <chain base_link="torso_lift_link" tip_link="arm_tool_link"/>
  </group>

  <group_state name="stow" group="arm">
    <joint name="arm_1_joint" value="0.50"/>
    <joint name="arm_2_joint" value="-1.34"/>
    <joint name="arm_3_joint" value="-0.48"/>
    <joint name="arm_4_joint" value="1.94"/>
    <joint name="arm_5_joint" value="-1.49"/>
    <joint name="arm_6_joint" value="1.37"/>
    <joint name="arm_7_joint" value="0.0"/>
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="arm_1_joint" value="0.21"/>
    <joint name="arm_2_joint" value="-0.2"/>
    <joint name="arm_3_joint" value="-2.2"/>
    <joint name="arm_4_joint" value="1.15"/>
    <joint name="arm_5_joint" value="-1.57"/>
    <joint name="arm_6_joint" value="0.2"/>
    <joint name="arm_7_joint" value="0.0"/>
  </group_state>

  <group name="gripper">
    <link name="gripper_link"/>
    <link name="gripper_left_finger_link"/>
    <link name="gripper_right_finger_link"/>
    <joint name="gripper_right_finger_joint"/>
    <passive_joint name="gripper_left_finger_joint"/>
  </group>

  <group_state name="open" group="gripper">
    <joint name="gripper_right_finger_joint" value="0.044"/>
    <joint name="gripper_left_finger_joint" value="0.044"/>
  </group_state>
  <group_state name="close" group="gripper">
    <joint name="gripper_right_finger_joint" value="0.0"/>
    <joint name="gripper_left_finger_joint" value="0.0"/>
  </group_state>

  <end_effector name="gripper" parent_link="arm_tool_link" group="gripper" parent_group="arm"/>

  <disable_collisions link1="torso_lift_link" link2="arm_1_link" reason="Adjacent"/>
  <disable_collisions link1="torso_lift_link" link2="arm_2_link" reason="Never"/>
  <disable_collisions link1="torso_fixed_link" link2="arm_1_link" reason="Never"/>
  <disable_collisions link1="torso_fixed_column_link" link2="arm_1_link" reason="Default"/>
  <disable_collisions link1="torso_fixed_column_link" link2="arm_2_link" reason="Default"/>
  <disable_collisions link1="arm_1_link" link2="arm_2_link" reason="Adjacent"/>
  <disable_collisions link1="arm_2_link" link2="arm_3_link" reason="Adjacent"/>
  <disable_collisions link1="arm_3_link" link2="arm_4_link" reason="Adjacent"/>
  <disable_collisions link1="arm_4_link" link2="arm_5_link" reason="Adjacent"/>
  <disable_collisions link1="arm_5_link" link2="arm_6_link" reason="Adjacent"/>
  <disable_collisions link1="arm_6_link" link2="arm_7_link" reason="Adjacent"/>
  <disable_collisions link1="arm_7_link" link2="arm_tool_link" reason="Adjacent"/>
  <disable_collisions link1="arm_tool_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="arm_7_link" link2="gripper_link" reason="Adjacent"/>
  <disable_collisions link1="arm_6_link" link2="gripper_link" reason="Never"/>
  <disable_collisions link1="arm_5_link" link2="arm_7_link" reason="Never"/>
  <disable_collisions link1="arm_6_link" link2="arm_tool_link" reason="Never"/>
  <disable_collisions link1="gripper_link" link2="gripper_left_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_link" link2="gripper_right_finger_link" reason="Adjacent"/>
  <disable_collisions link1="gripper_left_finger_link" link2="gripper_right_finger_link" reason="Default"/>
  <disable_collisions link1="arm_tool_link" link2="gripper_left_finger_link" reason="Never"/>
  <disable_collisions link1="arm_tool_link" link2="gripper_right_finger_link" reason="Never"/>
  <disable_collisions link1="arm_7_link" link2="gripper_left_finger_link" reason="Never"/>
  <disable_collisions link1="arm_7_link" link2="gripper_right_finger_link" reason="Never"/>
</robot>
