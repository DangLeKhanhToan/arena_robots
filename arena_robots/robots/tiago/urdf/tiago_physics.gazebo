<?xml version="1.0"?>
<robot xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="tiago_wheel_physics" params="side">
    <gazebo reference="wheel_${side}_link">
      <selfCollide>false</selfCollide>
      <mu1 value="1.0" />
      <mu2 value="1.0" />
      <kp value="10000000.0" />
      <kd value="1" />
      <fdir1 value="1 0 0" />
    </gazebo>
  </xacro:macro>

  <xacro:macro name="tiago_caster_physics" params="name">
    <gazebo reference="caster_${name}_2_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.0</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:tiago_wheel_physics side="left" />
  <xacro:tiago_wheel_physics side="right" />
  <xacro:tiago_caster_physics name="front_left" />
  <xacro:tiago_caster_physics name="front_right" />
  <xacro:tiago_caster_physics name="back_left" />
  <xacro:tiago_caster_physics name="back_right" />

</robot>
