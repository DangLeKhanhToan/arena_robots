<?xml version="1.0"?>
<robot name="tiago" xmlns:xacro="http://ros.org/wiki/xacro">

  <xacro:macro name="tiago_base_hw_controller">
    <ros2_control name="tiago_system" type="system">
      <hardware>
        <plugin>gz_ros2_control/GazeboSimSystem</plugin>
      </hardware>
      <joint name="wheel_left_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="wheel_right_joint">
        <command_interface name="velocity"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="torso_lift_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_1_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.5</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_2_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">-1.34</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_3_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">-0.48</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_4_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">1.94</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_5_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">-1.49</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_6_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">1.37</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="arm_7_joint">
        <command_interface name="position"/>
        <state_interface name="position">
          <param name="initial_value">0.0</param>
        </state_interface>
        <state_interface name="velocity"/>
      </joint>
      <joint name="gripper_right_finger_joint">
        <command_interface name="position"/>
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
      <joint name="gripper_left_finger_joint" mimic="true">
        <state_interface name="position"/>
        <state_interface name="velocity"/>
      </joint>
    </ros2_control>
  </xacro:macro>

</robot>
