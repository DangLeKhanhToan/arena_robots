<?xml version="1.0"?>
<robot name="p3at" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find arena_robots)/components/utils/inertia.urdf.xacro" />

  <xacro:property name="PI" value="3.1415926535897931" />
  <xacro:property name="axle_z" value="0.111" />
  <xacro:property name="wheel_radius" value="0.111" />
  <xacro:property name="wheel_width" value="0.075" />
  <xacro:property name="wheel_mass" value="0.5" />
  <xacro:property name="wheel_y" value="0.199" />

  <material name="p3at_red"><color rgba="0.851 0.0 0.0 1.0" /></material>
  <material name="p3at_black"><color rgba="0.038 0.038 0.038 1.0" /></material>
  <material name="p3at_yellow"><color rgba="0.715 0.583 0.210 1.0" /></material>
  <material name="p3at_hubcap"><color rgba="1.0 0.811 0.151 1.0" /></material>
  <material name="p3at_grey"><color rgba="0.5 0.5 0.5 1.0" /></material>
  <material name="p3at_tire"><color rgba="0.117 0.117 0.117 1.0" /></material>

  <link name="base_link"></link>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="chassis_link" />
  </joint>

  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 ${0.177 - axle_z}" rpy="0 0 0" />
      <geometry><mesh filename="package://arena_robots/robots/p3at/meshes/p2os_urdf/meshes/p3at_meshes/chassis.stl" /></geometry>
      <material name="p3at_red" />
    </visual>
    <collision>
      <origin xyz="0 0 ${0.177 - axle_z}" rpy="0 0 0" />
      <geometry><box size="0.498 0.28 0.192" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${0.177 - axle_z}" rpy="0 0 0" />
      <mass value="10.0" />
      <xacro:solid_cuboid_inertia m="10.0" w="0.498" h="0.28" d="0.192" />
    </inertial>
  </link>

  <joint name="top_plate_joint" type="fixed">
    <origin xyz="0.003 0 ${0.274 - axle_z}" rpy="0 0 0" />
    <parent link="chassis_link" />
    <child link="top_plate" />
  </joint>

  <link name="top_plate">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><mesh filename="package://arena_robots/robots/p3at/meshes/p2os_urdf/meshes/p3at_meshes/top.stl" /></geometry>
      <material name="p3at_black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.508 0.384 0.006" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="0.5" />
      <xacro:solid_cuboid_inertia m="0.5" w="0.508" h="0.384" d="0.006" />
    </inertial>
  </link>

  <xacro:macro name="sonar" params="name x z mesh">
    <joint name="${name}_sonar_joint" type="fixed">
      <origin xyz="${x} 0 ${z - axle_z}" rpy="0 0 0" />
      <parent link="chassis_link" />
      <child link="${name}_sonar" />
    </joint>

    <link name="${name}_sonar">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${mesh}" /></geometry>
        <material name="p3at_yellow" />
      </visual>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.1" />
        <xacro:solid_cuboid_inertia m="0.1" w="0.124" h="0.28" d="0.04" />
      </inertial>
    </link>
  </xacro:macro>

  <xacro:sonar name="front" x="0.193" z="0.25" mesh="package://arena_robots/robots/p3at/meshes/p2os_urdf/meshes/p3at_meshes/front_sonar.stl" />
  <xacro:sonar name="back" x="-0.187" z="0.247" mesh="package://arena_robots/robots/p3at/meshes/p2os_urdf/meshes/p3at_meshes/back_sonar.stl" />

  <xacro:macro name="wheel" params="prefix x y hubcap">
    <joint name="${prefix}_axle_joint" type="fixed">
      <origin xyz="${x} ${0.156 * y} 0" rpy="0 0 0" />
      <parent link="chassis_link" />
      <child link="${prefix}_axle" />
    </joint>

    <link name="${prefix}_axle">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="package://arena_robots/robots/p3at/meshes/p2os_urdf/meshes/p3at_meshes/axle.stl" /></geometry>
        <material name="p3at_grey" />
      </visual>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.1" />
        <xacro:solid_cuboid_inertia m="0.1" w="0.048" h="0.034" d="0.046" />
      </inertial>
    </link>

    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="package://arena_robots/robots/p3at/meshes/p2os_urdf/meshes/p3at_meshes/wheel.stl" /></geometry>
        <material name="p3at_tire" />
      </visual>
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><mesh filename="${hubcap}" /></geometry>
        <material name="p3at_hubcap" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}" /></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <mass value="${wheel_mass}" />
        <xacro:solid_cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" />
      </inertial>
    </link>

    <gazebo reference="${prefix}_wheel_link">
      <selfCollide>false</selfCollide>
      <mu1 value="1.0" />
      <mu2 value="0.6" />
      <kp value="10000000.0" />
      <kd value="1" />
      <fdir1 value="1 0 0" />
    </gazebo>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="chassis_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="${x} ${wheel_y * y} 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="front_left" x="0.135" y="1" hubcap="package://arena_robots/robots/p3at/meshes/p2os_urdf/meshes/p3at_meshes/left_hubcap.stl" />
  <xacro:wheel prefix="front_right" x="0.135" y="-1" hubcap="package://arena_robots/robots/p3at/meshes/p2os_urdf/meshes/p3at_meshes/right_hubcap.stl" />
  <xacro:wheel prefix="rear_left" x="-0.134" y="1" hubcap="package://arena_robots/robots/p3at/meshes/p2os_urdf/meshes/p3at_meshes/left_hubcap.stl" />
  <xacro:wheel prefix="rear_right" x="-0.134" y="-1" hubcap="package://arena_robots/robots/p3at/meshes/p2os_urdf/meshes/p3at_meshes/right_hubcap.stl" />

  <xacro:arg name="namespace" default="" />
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="sim_path" default="" />
  <xacro:arg name="gazebo_classic" default="false" />
  <xacro:arg name="gazebo_ignition" default="true" />

  <xacro:include filename="$(find arena_robots)/robots/p3at/urdf/base_hw/p3at.ros2_control.urdf" />
  <xacro:include filename="$(find arena_robots)/robots/p3at/urdf/p3at.gazebo" />

  <xacro:p3at_base_hw_controller />
</robot>
