<?xml version="1.0"?>
<robot name="temi" xmlns:xacro="http://www.ros.org/wiki/xacro">
  <xacro:include filename="$(find arena_robots)/components/utils/inertia.urdf.xacro" />

  <xacro:property name="PI" value="3.1415926535897931" />

  <xacro:property name="wheel_radius" value="0.06" />
  <xacro:property name="wheel_width" value="0.03" />
  <xacro:property name="wheel_mass" value="0.3" />
  <xacro:property name="wheel_y" value="0.14" />
  <xacro:property name="caster_radius" value="0.025" />
  <xacro:property name="caster_x" value="0.16" />
  <xacro:property name="caster_lift" value="0.003" />
  <xacro:property name="head_tilt" value="0.5" />

  <material name="temi_white"><color rgba="0.95 0.95 0.95 1.0" /></material>
  <material name="temi_black"><color rgba="0.1 0.1 0.1 1.0" /></material>

  <link name="base_link"></link>

  <joint name="base_link_joint" type="fixed">
    <origin xyz="0 0 0" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="chassis_link" />
  </joint>

  <link name="chassis_link">
    <visual>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <geometry><box size="0.40 0.34 0.06" /></geometry>
      <material name="temi_white" />
    </visual>
    <visual>
      <origin xyz="-0.10 0 0.10" rpy="0 0 0" />
      <geometry><box size="0.20 0.34 0.12" /></geometry>
      <material name="temi_white" />
    </visual>
    <visual>
      <origin xyz="0.10 0 0.15" rpy="0 0 0" />
      <geometry><box size="0.20 0.34 0.02" /></geometry>
      <material name="temi_black" />
    </visual>
    <collision>
      <origin xyz="0 0 0.01" rpy="0 0 0" />
      <geometry><box size="0.40 0.34 0.06" /></geometry>
    </collision>
    <collision>
      <origin xyz="-0.10 0 0.10" rpy="0 0 0" />
      <geometry><box size="0.20 0.34 0.12" /></geometry>
    </collision>
    <collision>
      <origin xyz="0.10 0 0.15" rpy="0 0 0" />
      <geometry><box size="0.20 0.34 0.02" /></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.03 0 0.05" rpy="0 0 0" />
      <mass value="7.0" />
      <xacro:solid_cuboid_inertia m="7.0" w="0.40" h="0.34" d="0.16" />
    </inertial>
  </link>

  <joint name="body_joint" type="fixed">
    <origin xyz="0 0 0.16" rpy="0 0 0" />
    <parent link="chassis_link" />
    <child link="body_link" />
  </joint>

  <link name="body_link">
    <visual>
      <origin xyz="-0.12 0 0.225" rpy="0 0 0" />
      <geometry><box size="0.10 0.20 0.45" /></geometry>
      <material name="temi_white" />
    </visual>
    <visual>
      <origin xyz="-0.08 0 0.54" rpy="0 0 0" />
      <geometry><box size="0.20 0.30 0.22" /></geometry>
      <material name="temi_white" />
    </visual>
    <visual>
      <origin xyz="0.025 0 0.52" rpy="0 0 0" />
      <geometry><box size="0.01 0.08 0.14" /></geometry>
      <material name="temi_black" />
    </visual>
    <visual>
      <origin xyz="-0.05 0 0.695" rpy="0 0 0" />
      <geometry><box size="0.06 0.10 0.09" /></geometry>
      <material name="temi_black" />
    </visual>
    <collision>
      <origin xyz="-0.12 0 0.225" rpy="0 0 0" />
      <geometry><box size="0.10 0.20 0.45" /></geometry>
    </collision>
    <collision>
      <origin xyz="-0.08 0 0.54" rpy="0 0 0" />
      <geometry><box size="0.20 0.30 0.22" /></geometry>
    </collision>
    <inertial>
      <origin xyz="-0.10 0 0.37" rpy="0 0 0" />
      <mass value="3.0" />
      <xacro:solid_cuboid_inertia m="3.0" w="0.20" h="0.30" d="0.65" />
    </inertial>
  </link>

  <joint name="head_joint" type="fixed">
    <origin xyz="-0.03 0 0.76" rpy="0 ${-head_tilt} 0" />
    <parent link="body_link" />
    <child link="head_link" />
  </joint>

  <link name="head_link">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.025 0.30 0.20" /></geometry>
      <material name="temi_black" />
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry><box size="0.025 0.30 0.20" /></geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <mass value="1.2" />
      <xacro:solid_cuboid_inertia m="1.2" w="0.025" h="0.30" d="0.20" />
    </inertial>
  </link>

  <xacro:macro name="wheel" params="prefix y">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}" /></geometry>
        <material name="temi_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <geometry><cylinder radius="${wheel_radius}" length="${wheel_width}" /></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="${PI/2} 0 0" />
        <mass value="${wheel_mass}" />
        <xacro:solid_cylinder_inertia m="${wheel_mass}" r="${wheel_radius}" h="${wheel_width}" />
      </inertial>
    </link>

    <gazebo reference="${prefix}_wheel_link">
      <selfCollide>false</selfCollide>
      <mu1 value="1.0" />
      <mu2 value="1.0" />
      <kp value="10000000.0" />
      <kd value="1" />
      <fdir1 value="1 0 0" />
    </gazebo>

    <joint name="${prefix}_wheel" type="continuous">
      <parent link="chassis_link" />
      <child link="${prefix}_wheel_link" />
      <origin xyz="0 ${y} 0" rpy="0 0 0" />
      <axis xyz="0 1 0" />
    </joint>
  </xacro:macro>

  <xacro:wheel prefix="left" y="${wheel_y}" />
  <xacro:wheel prefix="right" y="${-wheel_y}" />

  <xacro:macro name="caster" params="prefix x">
    <link name="${prefix}_caster_link">
      <visual>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><sphere radius="${caster_radius}" /></geometry>
        <material name="temi_black" />
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <geometry><sphere radius="${caster_radius}" /></geometry>
      </collision>
      <inertial>
        <origin xyz="0 0 0" rpy="0 0 0" />
        <mass value="0.1" />
        <xacro:solid_sphere_inertia m="0.1" r="${caster_radius}" />
      </inertial>
    </link>

    <joint name="${prefix}_caster_joint" type="fixed">
      <parent link="chassis_link" />
      <child link="${prefix}_caster_link" />
      <origin xyz="${x} 0 ${caster_radius - wheel_radius + caster_lift}" rpy="0 0 0" />
    </joint>

    <gazebo reference="${prefix}_caster_link">
      <mu1>0.0</mu1>
      <mu2>0.0</mu2>
      <kp>1000000.0</kp>
      <kd>100.0</kd>
      <minDepth>0.0</minDepth>
    </gazebo>
  </xacro:macro>

  <xacro:caster prefix="front" x="${caster_x}" />
  <xacro:caster prefix="rear" x="${-caster_x}" />

  <xacro:arg name="namespace" default="" />
  <xacro:arg name="prefix" default="" />
  <xacro:arg name="gazebo_classic" default="false" />
  <xacro:arg name="gazebo_ignition" default="true" />

  <xacro:include filename="$(find arena_robots)/robots/temi/urdf/base_hw/temi.ros2_control.urdf" />
  <xacro:include filename="$(find arena_robots)/robots/temi/urdf/temi.gazebo" />

  <xacro:temi_base_hw_controller />
</robot>
