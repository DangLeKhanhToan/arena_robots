<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="franka_hand_gripper_fragment">
  <xacro:arg name="prefix" default=""/>
  <xacro:arg name="mount" default="gripper"/>
  <xacro:arg name="arm" default="arm"/>

  <group name="$(arg mount)">
    <link name="$(arg prefix)$(arg mount)_fr3_hand"/>
    <link name="$(arg prefix)$(arg mount)_fr3_leftfinger"/>
    <link name="$(arg prefix)$(arg mount)_fr3_rightfinger"/>
    <joint name="$(arg prefix)$(arg mount)_fr3_finger_joint1"/>
    <passive_joint name="$(arg prefix)$(arg mount)_fr3_finger_joint2"/>
  </group>

  <group_state name="open" group="$(arg mount)">
    <joint name="$(arg prefix)$(arg mount)_fr3_finger_joint1" value="0.04"/>
    <joint name="$(arg prefix)$(arg mount)_fr3_finger_joint2" value="0.04"/>
  </group_state>
  <group_state name="close" group="$(arg mount)">
    <joint name="$(arg prefix)$(arg mount)_fr3_finger_joint1" value="0.0"/>
    <joint name="$(arg prefix)$(arg mount)_fr3_finger_joint2" value="0.0"/>
  </group_state>

  <end_effector name="$(arg mount)" parent_link="$(arg prefix)$(arg arm)_fr3_link8" group="$(arg mount)" parent_group="$(arg arm)_manipulator"/>

  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_hand" link2="$(arg prefix)$(arg mount)_fr3_leftfinger" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_hand" link2="$(arg prefix)$(arg mount)_fr3_rightfinger" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_leftfinger" link2="$(arg prefix)$(arg mount)_fr3_rightfinger" reason="Default"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_hand" link2="$(arg prefix)$(arg arm)_fr3_link3" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_leftfinger" link2="$(arg prefix)$(arg arm)_fr3_link3" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_rightfinger" link2="$(arg prefix)$(arg arm)_fr3_link3" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_hand" link2="$(arg prefix)$(arg arm)_fr3_link4" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_leftfinger" link2="$(arg prefix)$(arg arm)_fr3_link4" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_rightfinger" link2="$(arg prefix)$(arg arm)_fr3_link4" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_hand" link2="$(arg prefix)$(arg arm)_fr3_link6" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_leftfinger" link2="$(arg prefix)$(arg arm)_fr3_link6" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_rightfinger" link2="$(arg prefix)$(arg arm)_fr3_link6" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_hand" link2="$(arg prefix)$(arg arm)_fr3_link7" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_leftfinger" link2="$(arg prefix)$(arg arm)_fr3_link7" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_rightfinger" link2="$(arg prefix)$(arg arm)_fr3_link7" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_hand" link2="$(arg prefix)$(arg arm)_fr3_link8" reason="Adjacent"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_leftfinger" link2="$(arg prefix)$(arg arm)_fr3_link8" reason="Never"/>
  <disable_collisions link1="$(arg prefix)$(arg mount)_fr3_rightfinger" link2="$(arg prefix)$(arg arm)_fr3_link8" reason="Never"/>
</robot>
